{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "paths": {
      "@pointyink/serde/*": ["../serde/*"]
    }
  },
  "include": ["src/**/*.js", "src/**/*.d.ts"],
  "exclude": ["node_modules"]
}
