{
  "name": "@pointyink/tinymce",
  "version": "0.2.5",
  "description": "Make TinyMCE collaborative — drop-in real-time/offline sync backed by the Pointy engine.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pointyink/rogue.git"
  },
  "type": "module",
  "types": "./types/plugin.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "exports": {
    ".": {
      "types": "./types/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./scrub": {
      "types": "./types/scrub.d.ts",
      "default": "./dist/scrub.js"
    }
  },
  "scripts": {
    "build:types": "rm -rf types && tsc -p tsconfig.types.json",
    "build:dist": "rm -rf dist && esbuild plugin.js scrub.js --minify --outdir=dist --format=esm --platform=neutral",
    "prepublishOnly": "npm run build:dist"
  },
  "peerDependencies": {
    "tinymce": ">=6.0.0"
  },
  "dependencies": {
    "@pointyink/rogue": "^0.2.5"
  }
}
